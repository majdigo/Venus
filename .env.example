# =============================================================================
# Venus Estetika — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# --- Google Tag Manager (Server-Side) ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Sanity CMS (Headless Content) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-02-21

# --- Odoo CRM (Lead Management & Quotes) ---
ODOO_URL=https://venus-crm.odoo.com
ODOO_DB=venus_production
ODOO_USER=api@venus-estetika.com
ODOO_API_KEY=your_odoo_api_key

# --- Slack Notifications (New Lead Alerts) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Site URL (used by next-sitemap) ---
SITE_URL=https://venus-estetika.com
